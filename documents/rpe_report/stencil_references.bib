@inbook{Ahmad2025Gaussian,
author = {Zafar Ahmad and Rezaul Chowdhury and Rathish Das and Pramod Ganapathi and Aaron Gregory and Yimin Zhu},
title = {Speeding up Stencil Computation using Gaussian Approximations},
booktitle = {2025 Proceedings of the Conference on Applied and Computational Discrete Algorithms (ACDA)},
chapter = {},
pages = {276-292},
doi = {10.1137/1.9781611979084.21},
URL = {https://epubs.siam.org/doi/abs/10.1137/1.9781611979084.21},
eprint = {https://epubs.siam.org/doi/pdf/10.1137/1.9781611979084.21},
    abstract = { Abstract Stencils are widely used in scientific and industrial computing for the simulation of physical systems. Given a multidimensional spatial grid containing initial data, these stencil patterns are applied uniformly to all cells of the grid over multiple timesteps to obtain the final data. All known algorithms for general stencil computations performed Ω (NT ) work, where N is the number of cells of the grid and T is the number of timesteps, except for a few selected stencils, was it possible to perform stencil computations with asymptotically less work than those of their simple looping counterparts. In 2021, Ahmad et al. (SPAA 2021) reduced the computational complexity of performing linear stencil computations on periodic and aperiodic grids to o (NT) using the Fast Fourier Transform. In this paper, we present an approximation algorithm for linear stencil computations on free-space grids which performs work almost linear in the size of the grid and thus significantly improves over the computational complexities of all known algorithms for solving the problem exactly. Our paper is built on several interesting ideas: (i ) linear stencils can be modeled as biased random walks, (ii ) the influence of a linear stencil over multiple timesteps follows a Gaussian distribution, and (iii ) linear stencil computation can be modeled as an n-body problem taking the Gaussian as the force function and hence linear stencil computations can be performed efficiently using the fast Gauss transform. Our algorithm produces approximate results that are controlled by a tunable error parameter. We discuss several other applications of the Gaussian stencil approximation technique introduced in this paper: (1) periodic stencil computations, (2) aperiodic stencil computations with arbitrary boundary conditions, (3) European option pricing, and (4) computation of Pascal’s simplices. }
}

